---
import Layout from "../layouts/Layout.astro";

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---

<Layout
  title="Contact Us | BrightTech Industrial"
  description="Contact BrightTech Industrial for product sourcing, quotations, MOQ and lead time information."
  canonical={canonical}
>
  <section class="section">
    <div class="container contact-layout">
      <div class="contact-intro">
        <p class="eyebrow">Contact</p>

        <h1>Request a Quote</h1>

        <p id="inquiry-description">
          Tell us what product you are looking for. We will get back to you with
          pricing, lead time, MOQ, and sourcing details.
        </p>
      </div>

      <div id="selected-product" class="selected-product" hidden>
        <span class="selected-product__label"> Product Inquiry </span>

        <strong id="selected-product-name"></strong>
      </div>

      <form id="inquiry-form" class="inquiry-form">
        <div class="form-field">
          <label for="name">Name *</label>
          <input id="name" name="name" type="text" required />
        </div>

        <div class="form-field">
          <label for="email">Email *</label>
          <input id="email" name="email" type="email" required />
        </div>

        <div class="form-field">
          <label for="company">Company</label>
          <input id="company" name="company" type="text" />
        </div>

        <div class="form-field">
          <label for="country">Country</label>
          <input id="country" name="country" type="text" />
        </div>

        <div class="form-field">
          <label for="quantity">Quantity</label>
          <input id="quantity" name="quantity" type="number" min="1" />
        </div>

        <div class="form-field">
          <label for="message">Message *</label>

          <textarea id="message" name="message" rows="6" required></textarea>
        </div>

        <button id="submit-button" class="button-primary" type="submit">
          Send Inquiry
        </button>

        <p id="form-message" class="form-message" aria-live="polite"></p>

        <input type="hidden" id="product-name" name="productName" />

        <input type="hidden" id="product-slug" name="productSlug" />
      </form>
    </div>
  </section>
</Layout>

<style>
  .contact-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: start;
  }

  .contact-intro h1 {
    margin-top: 0;
    font-size: clamp(2rem, 5vw, 3.5rem);
  }

  .inquiry-form {
    display: grid;
    gap: 20px;
  }

  .form-field {
    display: grid;
    gap: 8px;
  }

  .form-field label {
    font-weight: 600;
  }

  .form-field input,
  .form-field textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font: inherit;
  }

  .form-field textarea {
    resize: vertical;
  }

  @media (max-width: 800px) {
    .contact-layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  .form-message {
    min-height: 24px;
    margin: 0;
    color: var(--color-muted);
  }

  .selected-product {
    margin-bottom: 24px;
    padding: 16px 18px;

    background: var(--color-surface-muted);
    border: 1px solid var(--color-border);
    border-radius: 10px;
  }

  .selected-product__label {
    display: block;
    margin-bottom: 6px;

    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .selected-product strong {
    font-size: 1rem;
  }
</style>

<script>
  import type {
    CreateInquiryInput,
    SubmitInquiryResponse,
  } from "../types/inquiry";
  import { validateInquiry } from "../validators/inquiryValidator";
  import { mapFormDataToInquiry } from "../mappers/inquiryMapper";
  import type { RequestState } from "../types/requestState";

  // 1. DOM 初始化
  const form = document.querySelector<HTMLFormElement>("#inquiry-form");

  const messageElement =
    document.querySelector<HTMLParagraphElement>("#form-message");

  const submitButton =
    document.querySelector<HTMLButtonElement>("#submit-button");

  const productNameInput =
    document.querySelector<HTMLInputElement>("#product-name");

  const productSlugInput =
    document.querySelector<HTMLInputElement>("#product-slug");

  const selectedProductElement =
    document.querySelector<HTMLDivElement>("#selected-product");

  const selectedProductNameElement = document.querySelector<HTMLElement>(
    "#selected-product-name",
  );

  const inquiryDescriptionElement =
    document.querySelector<HTMLParagraphElement>("#inquiry-description");

  // 2. 页面状态初始化
  let state: RequestState<SubmitInquiryResponse> = {
    status: "idle",
  };

  // 3. 读取 URL 中的产品上下文
  if (productNameInput && productSlugInput) {
    const searchParams = new URLSearchParams(window.location.search);

    productNameInput.value = searchParams.get("productName") ?? "";

    productSlugInput.value = searchParams.get("productSlug") ?? "";
  }

  // 4. 显示当前询问产品
  if (
    selectedProductElement &&
    selectedProductNameElement &&
    productNameInput?.value
  ) {
    selectedProductElement.hidden = false;

    selectedProductNameElement.textContent = productNameInput.value;
  }

  if (inquiryDescriptionElement && productNameInput?.value) {
    inquiryDescriptionElement.textContent =
      "Tell us your quantity and requirements. We'll get back to you with pricing, MOQ, lead time, and shipping details.";
  }

  function renderState(state: RequestState<SubmitInquiryResponse>) {
    if (!messageElement) {
      return;
    }

    switch (state.status) {
      case "idle":
        messageElement.textContent = "";
        break;

      case "loading":
        messageElement.textContent = "Sending inquiry...";
        break;

      case "success":
        messageElement.textContent =
          "Inquiry submitted successfully. We will get back to you soon.";
        break;

      case "error":
        messageElement.textContent = state.message;
        break;
    }

    if (submitButton) {
      submitButton.disabled = state.status === "loading";

      submitButton.textContent =
        state.status === "loading" ? "Sending..." : "Send Inquiry";
    }
  }

  if (form && messageElement) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (state.status === "loading") {
        return;
      }

      state = {
        status: "loading",
      };

      renderState(state);

      const formData = new FormData(form);

      const inquiry = mapFormDataToInquiry(formData);

      const validationResult = validateInquiry(inquiry);

      if (!validationResult.ok) {
        state = {
          status: "error",
          message: validationResult.error.message,
        };

        renderState(state);

        const fieldElement = form.elements.namedItem(
          validationResult.error.field,
        );

        if (fieldElement instanceof HTMLElement) {
          fieldElement.focus();
        }

        return;
      }

      state = {
        status: "loading",
      };

      renderState(state);

      const response = await fetch("/api/inquiry", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(validationResult.data),
      });

      const result = await response.json();

      if (!response.ok) {
        state = {
          status: "error",
          message: result.message ?? "Failed to submit inquiry.",
        };

        renderState(state);
        return;
      }

      state = {
        status: "success",
        data: {
          inquiryId: result.inquiryId,
        },
      };

      renderState(state);

      form.reset();

      console.log("Inquiry ID:", result.inquiryId);
    });
  }
</script>
