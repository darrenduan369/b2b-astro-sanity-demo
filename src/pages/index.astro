---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';

const featuredProducts = products.filter(
  (product) => product.featured,
);
---

<Layout
  title="BrightTech Industrial | Global B2B Supplier"
  description="Reliable industrial products for global buyers."
>
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">Global B2B Supplier</p>

      <h1>
        Reliable Industrial Products for Global Buyers
      </h1>

      <p class="hero-description">
        We help international buyers source reliable industrial
        products from China with clear communication and efficient
        delivery.
      </p>

      <div class="hero-actions">
        <a class="button-primary" href="/products">
          View Products
        </a>
        <a class="text-link" href="/contact">
          Contact Us
        </a>
      </div>
    </div>
  </section>

  <section class="featured-products">
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Featured Products</p>
        <h2>Popular Products</h2>
      </div>

      <a href="/products">
        View All Products →
      </a>
    </div>

    <div class="product-grid">
      {
        featuredProducts.map((product) => (
          <ProductCard product={product} />
        ))
      }
    </div>
  </div>
</section>
</Layout>

<style>
  .hero {
    padding: 96px 0;
  }

  .hero-inner {
    max-width: 760px;
  }

  .eyebrow {
    font-weight: 600;
    margin-bottom: 16px;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.05;
    margin: 0;
  }

  .hero-description {
    margin-top: 24px;
    font-size: 1.15rem;
    max-width: 640px;
  }

  .hero-actions {
    margin-top: 32px;
    display: flex;
    gap: 20px;
    align-items: center;
  }

  .secondary-link {
    text-decoration: underline;
  }

  .featured-products {
  padding: 64px 0 96px;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 24px;
  margin-bottom: 32px;
}

.section-heading h2 {
  margin: 0;
  font-size: 2rem;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

@media (max-width: 900px) {
  .product-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 640px) {
  .section-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .product-grid {
    grid-template-columns: 1fr;
  }
}
</style>