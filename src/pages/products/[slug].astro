---
import Layout from "../../layouts/Layout.astro";
import {
  fetchProducts,
  fetchProductBySlug,
} from "../../services/productService";

export async function getStaticPaths() {
  const products = await fetchProducts();

  return products.map((product) => ({
    params: {
      slug: product.slug,
    },
  }));
}

const { slug } = Astro.params;

if (!slug) {
  throw new Error("Product slug is missing");
}

const product = await fetchProductBySlug(slug);

if (!product) {
  throw new Error(`Product ${slug} not found`);
}

const pageTitle =
  product.seoTitle?.trim() || `${product.name} | BrightTech Industrial`;

const pageDescription =
  product.seoDescription?.trim() ||
  product.description ||
  `Learn more about ${product.name} from BrightTech Industrial.`;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const productStructuredData = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.name,
  description: pageDescription,
  image: product.imageUrl ? [product.imageUrl] : undefined,
  category: product.category,
  brand: {
    "@type": "Brand",
    name: "BrightTech Industrial",
  },
  offers: {
    "@type": "Offer",
    url: canonical,
    priceCurrency: "USD",
    price: product.price,
    availability: "https://schema.org/InStock",
  },
};
---

<script
  type="application/ld+json"
  set:html={JSON.stringify(productStructuredData)}
/>

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  image={product.imageUrl}
>
  <section class="product-detail">
    <div class="container product-detail__grid">
      <div class="product-media">
        {
          product.imageUrl ? (
            <img
              class="product-image"
              src={product.imageUrl}
              alt={product.name}
            />
          ) : (
            <div class="product-placeholder">No product image</div>
          )
        }
      </div>

      <div class="product-detail__content">
        <p class="product-category">
          {product.category}
        </p>

        <h1>{product.name}</h1>

        <p class="product-price">
          ${product.price}
        </p>

        <p class="product-description">
          Reliable industrial product for global buyers. Contact us for
          specifications, MOQ, lead time, and quotation details.
        </p>

        <a
          class="quote-button"
          href={`/contact?productName=${encodeURIComponent(product.name)}
          &productSlug=${encodeURIComponent(product.slug)}`}
        >
          Request Quote
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .product-detail {
    padding: 64px 0;
  }

  .product-detail__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .product-placeholder {
    min-height: 420px;
    display: grid;
    place-items: center;
    background: var(--color-surface-muted);
    border-radius: var(--radius-lg);
  }

  .product-category {
    margin: 0 0 12px;
    font-size: 0.9rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
  }

  .product-price {
    margin: 24px 0;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .product-description {
    max-width: 560px;
    line-height: 1.7;
  }

  .quote-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    margin-top: 12px;
    padding: 14px 24px;

    background: #111827;
    color: #ffffff;

    border-radius: 8px;

    font-weight: 600;
    text-decoration: none;

    transition:
      transform 0.2s ease,
      background-color 0.2s ease;
  }

  .quote-button:hover {
    background: #1f2937;
    transform: translateY(-1px);
  }

  @media (max-width: 800px) {
    .product-detail__grid {
      grid-template-columns: 1fr;
    }

    .product-placeholder {
      min-height: 280px;
    }

    .product-image {
      width: 100%;
      min-height: 420px;
      object-fit: cover;
      border-radius: var(--radius-lg);
    }
  }
</style>
